{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requirements.schema.json",
  "title": "Requirements registry (.raftly/requirements.yaml)",
  "type": "object",
  "required": [
    "requirements"
  ],
  "additionalProperties": false,
  "properties": {
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "priority",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REQ-\\d{3,}$"
          },
          "statement": {
            "type": "string",
            "minLength": 3
          },
          "priority": {
            "enum": [
              "MUST",
              "SHOULD",
              "COULD",
              "WONT"
            ]
          },
          "status": {
            "enum": [
              "ACTIVE",
              "SUPERSEDED",
              "DROPPED"
            ]
          },
          "rationale": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "decisions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "supersedes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "superseded_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "string"
          },
          "changed_at": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
