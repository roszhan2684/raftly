{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gate.schema.json",
  "title": "Production gate results (.raftly/gate.yaml)",
  "type": "object",
  "required": [
    "checks"
  ],
  "additionalProperties": false,
  "properties": {
    "generated_at": {
      "type": "string"
    },
    "evaluated_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "profile": {
      "type": "object"
    },
    "summary": {
      "type": "object"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "group",
          "category",
          "title",
          "severity",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^G-[A-Z0-9-]+$"
          },
          "group": {
            "enum": [
              "production",
              "forgotten-20"
            ]
          },
          "category": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "blocker",
              "major",
              "minor"
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "WARNING",
              "FAIL",
              "UNVERIFIED",
              "NOT_APPLICABLE"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          },
          "na_reason": {
            "type": "string"
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
