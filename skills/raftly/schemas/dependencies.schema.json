{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dependencies.schema.json",
  "title": "Dependency registry (.raftly/dependencies.yaml)",
  "type": "object",
  "required": [
    "dependencies"
  ],
  "additionalProperties": false,
  "properties": {
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "purpose",
          "license",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "purpose": {
            "type": "string"
          },
          "license": {
            "type": "string",
            "description": "SPDX id, or UNVERIFIED when not yet checked"
          },
          "source": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "library",
              "service",
              "tool",
              "framework",
              "runtime",
              "dataset",
              "model"
            ]
          },
          "chosen_by": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "PROPOSED",
              "ADOPTED",
              "REJECTED",
              "REMOVED"
            ]
          },
          "lock_in": {
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          },
          "replacement_notes": {
            "type": "string"
          },
          "last_review": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "cost_mode": {
      "enum": [
        "BOOTSTRAP",
        "FUNDED",
        "ENTERPRISE"
      ]
    }
  }
}
